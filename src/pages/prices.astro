---
import Base from '@/layouts/Base.astro';
import PriceTracker from '@/components/PriceTracker.tsx';
---

<Base
  title="Construction Material Prices in Kenya — August 2026 | JengaCalc"
  description="Live construction material prices in Kenya. Track cement, steel, mabati, tiles, timber, paint, and more. Updated monthly with real prices from across the country."
>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-20">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow text-clay-300">Material Prices</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        Construction material prices in Kenya
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        Track current prices for cement, steel, mabati, timber, paint, tiles, and more. Updated monthly. See a price that's different in your area? Submit it and help other builders.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <PriceTracker client:load />
  </section>

  <section class="container-prose border-t border-ink-200 py-12">
    <h2 class="font-display text-2xl font-medium text-ink-900">About these prices</h2>
    <div class="prose-kenya mt-4">
      <p>
        These prices are national averages compiled from hardware store surveys, supplier websites (Bamburi, Crown Paints, Mabati Rolling Mills), Jumia Building Materials listings, and user submissions. Prices in your local area may vary by KES 30–100 per unit depending on transport costs and local supply.
      </p>
      <p>
        <strong>How to use these prices:</strong> When a fundi or contractor quotes you for materials, compare their quote to these prices. If their quote is 15–20% higher, ask why. If it's much lower, check whether they're buying the right grade — cheap cement and thin-gauge mabati cost less but fail faster.
      </p>
      <p>
        We update these prices monthly. Prices for cement and steel move with global commodity markets; prices for timber and aggregates move with local supply and transport costs. Always confirm the current price at your supplier before committing to a budget.
      </p>
    </div>
  </section>
</Base>
