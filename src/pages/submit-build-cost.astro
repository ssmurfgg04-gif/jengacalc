---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { COUNTIES, HOUSE_TYPES, FINISH_TIERS, type HouseType, type FinishTier } from '@/data/kenya';
---

<Base
  title="Share Your Build Cost — Help Other Kenyan Builders | JengaCalc"
  description="Submit your actual construction cost to help other Kenyan builders get better estimates. Anonymous and takes 2 minutes."
>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-20">
    <div class="container-wide max-w-3xl">
      <Breadcrumbs onDark items={[
        { label: 'Home', href: '/' },
        { label: 'Submit Build Cost' },
      ]} />
      <p class="eyebrow text-clay-300">Crowdsource</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        Share your actual build cost
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        Real build cost data from real Kenyan builders is what makes this tool better over time. Share what your project actually cost — it takes 2 minutes and helps everyone.
      </p>
    </div>
  </section>

  <section class="container-prose py-12 md:py-16">
    <div id="submit-build-cost-form"></div>
    <p class="text-sm text-ink-500">Fill in the details of your completed build. Your submission will be reviewed and added to our dataset to improve estimates for other builders in your county.</p>

    <div class="mt-6 flex flex-wrap items-center gap-4 rounded-md border border-ink-200 bg-white p-4">
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-moss-400"></span>
        <p class="text-sm text-ink-600">
          <strong class="font-display text-ink-900" id="bc-total">—</strong> real build costs shared
        </p>
      </div>
      <div class="ml-auto">
        <button type="button" id="bc-export" class="btn-ghost text-sm">Export submissions (CSV)</button>
      </div>
    </div>

    <div class="hidden mt-6">
      <h2 class="font-display text-xl font-medium text-ink-900">Recent real build costs</h2>
      <ul id="bc-recent" class="mt-4 space-y-2"></ul>
    </div>

    <form id="build-cost-form" class="mt-8 space-y-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="bc-county" class="eyebrow mb-1.5 block">County *</label>
          <select id="bc-county" name="county" class="select-field" required>
            {COUNTIES.map((c) => (
              <option value={c.name}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="bc-type" class="eyebrow mb-1.5 block">House Type *</label>
          <select id="bc-type" name="house_type" class="select-field" required>
            {HOUSE_TYPES.map((t) => (
              <option value={t.value}>{t.label}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="bc-bedrooms" class="eyebrow mb-1.5 block">Bedrooms *</label>
          <input id="bc-bedrooms" name="bedrooms" type="number" min="1" max="10" value="3" class="input-field" required />
        </div>
        <div>
          <label for="bc-size" class="eyebrow mb-1.5 block">Floor Area (sqm) *</label>
          <input id="bc-size" name="size_sqm" type="number" min="10" max="500" value="100" class="input-field" required />
        </div>
        <div>
          <label for="bc-tier" class="eyebrow mb-1.5 block">Finish Level *</label>
          <select id="bc-tier" name="finish_tier" class="select-field" required>
            {FINISH_TIERS.map((t) => (
              <option value={t.value}>{t.label}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="bc-cost" class="eyebrow mb-1.5 block">Total Cost (KES) *</label>
          <input id="bc-cost" name="total_cost_kes" type="number" min="100000" max="50000000" value="5000000" class="input-field" required />
        </div>
      </div>

      <div>
        <label for="bc-name" class="eyebrow mb-1.5 block">Your Name (optional)</label>
        <input id="bc-name" name="submitter_name" type="text" class="input-field" placeholder="Optional — we won't publish your name" />
      </div>

      <div>
        <label for="bc-notes" class="eyebrow mb-1.5 block">Notes (optional)</label>
        <textarea id="bc-notes" name="notes" rows="3" class="input-field" placeholder="e.g. Built in 2025, black cotton soil, added a borehole..."></textarea>
      </div>

      <div id="bc-error" class="hidden rounded-md border border-rust-500 bg-rust-500/10 p-3 text-sm text-rust-600"></div>
      <div id="bc-success" class="hidden rounded-md border border-moss-200 bg-moss-50 p-4">
        <p class="font-display text-base text-moss-500">Thank you for sharing!</p>
        <p class="mt-1 text-sm text-ink-600">Your build cost has been recorded and will help other builders get better estimates.</p>
      </div>

      <button type="submit" class="btn-primary">Submit My Build Cost</button>
    </form>
  </section>
</Base>

<script>
  import { submitBuildCost, fetchRecentBuildCosts, exportBuildCostsCsv } from '@/lib/clientStore';

  const form = document.getElementById('build-cost-form') as HTMLFormElement;
  const errorEl = document.getElementById('bc-error');
  const successEl = document.getElementById('bc-success');
  const counterEl = document.getElementById('bc-total');
  const recentEl = document.getElementById('bc-recent');
  const exportBtn = document.getElementById('bc-export');

  function fmt(n: number): string {
    return n.toLocaleString('en-KE');
  }

  async function loadRecent() {
    const { total, submissions } = await fetchRecentBuildCosts();
    if (counterEl) counterEl.textContent = total > 0 ? fmt(total) : '—';
    if (recentEl && submissions.length > 0) {
      recentEl.innerHTML = submissions
        .slice(0, 8)
        .map(
          (s) => `
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-ink-100 bg-white px-4 py-3">
            <div>
              <p class="text-sm font-medium text-ink-800">${s.houseType} &middot; ${s.bedrooms} bedroom</p>
              <p class="text-xs text-ink-400">${s.county} &middot; ~${s.sizeSqm} sqm &middot; ${new Date(s.createdAt).toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
            </div>
            <p class="font-mono text-sm font-semibold text-clay-600">KES ${fmt(s.totalCostKes)}</p>
          </li>`,
        )
        .join('');
      recentEl.closest('.hidden')?.classList.remove('hidden');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl?.classList.add('hidden');
    successEl?.classList.add('hidden');

    const formData = new FormData(form);
    const payload = {
      county: formData.get('county') as string,
      houseType: formData.get('house_type') as string,
      bedrooms: Number(formData.get('bedrooms')),
      sizeSqm: Number(formData.get('size_sqm')),
      finishTier: formData.get('finish_tier') as string,
      totalCostKes: Number(formData.get('total_cost_kes')),
      submitterName: (formData.get('submitter_name') as string) || undefined,
      notes: (formData.get('notes') as string) || undefined,
    };

    if (!payload.county || !payload.houseType || !payload.bedrooms || !payload.sizeSqm || !payload.totalCostKes) {
      errorEl.textContent = 'Please fill in all required fields.';
      errorEl?.classList.remove('hidden');
      return;
    }

    const ok = await submitBuildCost(payload);
    if (ok) {
      successEl?.classList.remove('hidden');
      form.reset();
      successEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      loadRecent();
    } else {
      errorEl.textContent = 'Something went wrong. Please try again.';
      errorEl?.classList.remove('hidden');
    }
  });

  exportBtn?.addEventListener('click', () => exportBuildCostsCsv());

  loadRecent();
</script>
