---
import Base from '@/layouts/Base.astro';
import { COUNTIES } from '@/data/kenya';
---

<Base
  title="Build Costs by County in Kenya | JengaCalc"
  description="Construction cost guides for every major county in Kenya. See how labor and transport costs vary across Nairobi, Kiambu, Nakuru, Mombasa, Kisumu, and more."
>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-20">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow text-clay-300">Counties</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        Build costs by county
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        Labor and transport costs vary significantly across Kenya. Find your county to see how it affects your build budget — and get a tailored cost estimate.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {COUNTIES.map((county) => (
        <a
          href={`/counties/${county.slug}`}
          class="card group flex items-center justify-between p-5 transition-all hover:shadow-md"
        >
          <div>
            <h2 class="font-display text-lg font-medium text-ink-900 group-hover:text-clay-700">
              {county.name}
            </h2>
            <p class="mt-1 text-xs text-ink-400">{county.region} region</p>
          </div>
          <div class="text-right">
            <p class="font-mono text-xs text-ink-400">Labor</p>
            <p class="font-mono text-sm font-semibold text-clay-600">
              {county.laborMultiplier > 1 ? '+' : ''}{Math.round((county.laborMultiplier - 1) * 100)}%
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
