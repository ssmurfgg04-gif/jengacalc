---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CostCalculator from '@/components/CostCalculator.tsx';
import { COUNTIES, HOUSE_TYPES, FINISH_TIERS } from '@/data/kenya';
import { calculateEstimate, formatKes } from '@/lib/costEngine';

export function getStaticPaths() {
  return COUNTIES.map((county) => ({
    params: { slug: county.slug },
    props: { county },
  }));
}

const { county } = Astro.props;

const houseTypes = [
  { type: 'bungalow' as const, bedrooms: 3, tier: 'mid' as const, label: '3-Bedroom Bungalow' },
  { type: 'maisonette' as const, bedrooms: 4, tier: 'mid' as const, label: '4-Bedroom Maisonette' },
  { type: 'bungalow' as const, bedrooms: 2, tier: 'basic' as const, label: '2-Bedroom Bungalow (Basic)' },
  { type: 'bedsitter' as const, bedrooms: 1, tier: 'basic' as const, label: 'Bedsitter (Basic)' },
];

const estimates = houseTypes.map((h) => {
  const sizeSqm = h.type === 'bedsitter' ? 20 : h.type === 'maisonette' ? 60 + h.bedrooms * 18 : 45 + h.bedrooms * 20;
  return {
    ...h,
    sizeSqm,
    result: calculateEstimate({
      countySlug: county.slug,
      houseType: h.type,
      bedrooms: h.bedrooms,
      finishTier: h.tier,
      sizeSqm,
    }),
  };
});

const laborText = county.laborMultiplier > 1
  ? `${Math.round((county.laborMultiplier - 1) * 100)}% higher than the national average`
  : county.laborMultiplier < 1
    ? `${Math.round((1 - county.laborMultiplier) * 100)}% lower than the national average`
    : 'in line with the national average';

const transportText = county.transportMultiplier > 1
  ? `${Math.round((county.transportMultiplier - 1) * 100)}% above baseline`
  : 'at baseline';

function prefillHref(h: { type: string; bedrooms: number; tier: string; sizeSqm: number }): string {
  const p = new URLSearchParams({
    county: county.slug,
    houseType: h.type,
    bedrooms: String(h.bedrooms),
    finish: h.tier,
    size: String(h.sizeSqm),
  });
  return `/calculator?${p.toString()}`;
}
---

<Base
  title={`Cost to Build in ${county.name} — Kenya Build Cost Guide | JengaCalc`}
  description={`How much does it cost to build a house in ${county.name}, Kenya? Get county-specific construction cost estimates for bungalows, maisonettes, and rental units. Updated August 2026.`}
>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-20">
    <div class="container-wide max-w-3xl">
      <Breadcrumbs onDark items={[
        { label: 'Home', href: '/' },
        { label: 'Counties', href: '/counties' },
        { label: county.name },
      ]} />
      <p class="eyebrow text-clay-300">{county.region} Region</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        Cost to build in {county.name}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        Construction cost estimates for {county.name} with county-specific labor and transport adjustments. Get a tailored Bill of Quantities for your project.
      </p>
    </div>
  </section>

  {/* Quick estimates table */}
  <section class="container-wide py-12 md:py-16">
    <h2 class="font-display text-2xl font-medium text-ink-900">Quick cost estimates for {county.name}</h2>
    <p class="mt-2 text-sm text-ink-500">Typical cost ranges for common house types in {county.name}.</p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b-2 border-ink-200 text-left">
            <th class="px-3 py-3 font-medium text-ink-500">House Type</th>
            <th class="px-3 py-3 font-medium text-ink-500">Size</th>
            <th class="px-3 py-3 font-medium text-ink-500">Finish Level</th>
            <th class="px-3 py-3 text-right font-medium text-ink-500">Low</th>
            <th class="px-3 py-3 text-right font-medium text-ink-500">High</th>
            <th class="px-3 py-3 font-medium text-ink-500"></th>
          </tr>
        </thead>
        <tbody>
          {estimates.map((e) => (
            <tr class="border-b border-ink-100">
              <td class="px-3 py-3 font-medium text-ink-800">{e.label}</td>
              <td class="px-3 py-3 text-ink-500">{e.sizeSqm} sqm</td>
              <td class="px-3 py-3 text-ink-500">{FINISH_TIERS.find((t) => t.value === e.tier)?.label}</td>
              <td class="px-3 py-3 text-right font-mono text-ink-700">{formatKes(e.result.totalLow)}</td>
              <td class="px-3 py-3 text-right font-mono font-semibold text-ink-900">{formatKes(e.result.totalHigh)}</td>
              <td class="px-3 py-3 text-right">
                <a href={prefillHref(e)} class="text-sm font-medium text-clay-600 hover:text-clay-700">Personalize &rarr;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-400">
      Estimates are for construction only. Add professional fees (3–5%), approvals (KES 100k–200k), and 10% contingency for your all-in budget.
    </p>
  </section>

  {/* County-specific calculator */}
  <section class="border-t border-ink-200 bg-white py-12 md:py-16">
    <div class="container-wide">
      <h2 class="font-display text-2xl font-medium text-ink-900">Get a detailed estimate for {county.name}</h2>
      <p class="mt-2 text-sm text-ink-500">Adjust the inputs to match your project.</p>
      <div class="mt-8">
        <CostCalculator
          client:idle
          defaultCounty={county.slug}
        />
      </div>
    </div>
  </section>

  {/* County info */}
  <section class="container-prose border-t border-ink-200 py-12">
    <h2 class="font-display text-2xl font-medium text-ink-900">Building in {county.name}: what to know</h2>
    <div class="prose-kenya mt-4">
      <p>
        {county.name} is in the {county.region} region of Kenya. Construction costs here are shaped by two main factors: <strong>labor rates</strong> and <strong>transport costs</strong>.
      </p>
      <p>
        <strong>Labor:</strong> Labor costs in {county.name} are {laborText}. This affects the labor and supervision portion of your build (roughly 10% of total construction cost).
      </p>
      <p>
        <strong>Transport:</strong> Material transport costs are {transportText}. If {county.name} is far from cement factories (Bamburi in Mombasa, Savanna/Simba in Kitui/Machakos, EAPC in Kajiado) or major hardware hubs, your material prices will be higher than the national average.
      </p>
      <p>
        <strong>Soil conditions:</strong> Always do a soil test before choosing your foundation. Black cotton soil (common in low-lying areas) requires a raft foundation, which adds 30–50% to foundation costs. A soil test costs KES 15,000–35,000 and tells you exactly what you need.
      </p>
      <p>
        <strong>Approvals:</strong> Budget KES 100,000–200,000 for county building permits, NCA registration, and utility connections. These must be in place before construction starts.
      </p>
      <p>
        Use the calculator above to get a tailored estimate for your specific project in {county.name}.
      </p>
    </div>
  </section>
</Base>
