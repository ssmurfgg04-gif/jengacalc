---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
---

<Base
  title="Page Not Found | JengaCalc"
  description="The page you're looking for doesn't exist. Use the JengaCalc calculator to estimate your build cost in Kenya."
>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-24">
    <div class="container-wide max-w-3xl">
      <Breadcrumbs onDark items={[
        { label: 'Home', href: '/' },
        { label: '404' },
      ]} />
      <p class="eyebrow text-clay-300">404</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        This page doesn't exist
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        The page you're looking for may have moved. Start fresh with a free build cost estimate, or browse our county and material price guides.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/calculator" class="btn-primary">Get an estimate</a>
        <a href="/" class="rounded-md border border-ink-300 bg-transparent px-6 py-3 text-sm font-semibold text-ink-50 transition-all hover:border-ink-100 hover:bg-ink-800">Back to home</a>
      </div>
    </div>
  </section>

  <section class="container-prose py-12">
    <h2 class="font-display text-2xl font-medium text-ink-900">Popular pages</h2>
    <ul class="mt-4 space-y-2">
      <li><a href="/calculator" class="link-underline text-clay-600">Build cost calculator</a></li>
      <li><a href="/counties" class="link-underline text-clay-600">Cost to build by county</a></li>
      <li><a href="/prices" class="link-underline text-clay-600">Material prices</a></li>
      <li><a href="/guides" class="link-underline text-clay-600">Guides</a></li>
    </ul>
  </section>
</Base>
