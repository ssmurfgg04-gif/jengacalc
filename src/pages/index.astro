---
import Base from '@/layouts/Base.astro';
import CostCalculator from '@/components/CostCalculator.tsx';
import { GUIDES } from '@/data/kenya';
import { MATERIAL_PRICES } from '@/data/kenya';

const featuredGuides = GUIDES.slice(0, 6);
const popularMaterials = MATERIAL_PRICES.filter((m) =>
  ['Cement', 'Steel', 'Roofing'].includes(m.category)
).slice(0, 6);
---

<Base>
  <section slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'How much does it cost to build a house per square metre in Kenya in 2026?', acceptedAnswer: { '@type': 'Answer', text: 'Roughly KES 35,000–45,000/m² for basic finishes, 50,000–65,000/m² for mid-range, and 70,000–95,000/m² for high-end, before land. Central Nairobi runs 25–30% above the national average.' } },
        { '@type': 'Question', name: 'Is black cotton soil a problem for building in Kenya?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, in areas like Kitengela, Syokimau, Athi River, Kamulu, and parts of Kajiado, Kiambu, Machakos, and the Rift Valley. A soil test and a raft foundation, soil replacement, or piles are essential and can add 30–50% to foundation cost.' } },
        { '@type': 'Question', name: 'How do I avoid being scammed when building remotely from abroad?', acceptedAnswer: { '@type': 'Answer', text: 'Never pay more than 10% mobilisation upfront, pay in stages with a 10% retention per stage, hold a final 10% until the defects period ends, appoint someone on the ground to inspect weekly, and get a written contract.' } },
        { '@type': 'Question', name: 'Why do material prices vary so much between counties?', acceptedAnswer: { '@type': 'Answer', text: 'Transport and supply chains. Nairobi has the cheapest delivered materials; rural and coastal counties pay a delivery premium. We adjust every material and labor rate by county rather than giving one national figure.' } },
      ],
    })} />
  </section>

  {/* Hero */}
  <section class="relative overflow-hidden border-b border-ink-200 bg-ink-900 text-ink-50">
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23F5E8D8%22%20fill-opacity%3D%220.4%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E');"></div>

    <div class="container-wide relative py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="eyebrow text-clay-300">Kenya Build Cost Calculator</p>
        <h1 class="mt-4 font-display text-display-lg font-semibold leading-[0.95] tracking-tight text-ink-50 text-balance">
          Know what your house will cost <em class="text-clay-300 not-italic">before</em> you pour the foundation.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300 text-pretty">
          Get an itemised Bill of Quantities for your build in seconds. Real prices for cement, steel, mabati, and more — updated monthly across all 47 counties.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/calculator" class="btn-primary">Calculate My Build Cost</a>
          <a href="/prices" class="btn-ghost border-ink-600 text-ink-200 hover:bg-ink-800">Browse Material Prices</a>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-ink-400">
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-moss-300"></span>
            Updated August 2026
          </div>
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-moss-300"></span>
            16 counties covered
          </div>
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-moss-300"></span>
            30+ materials tracked
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Popular searches */}
  <section class="border-b border-ink-200 bg-ink-50 py-10">
    <div class="container-wide">
      <p class="eyebrow mb-4">Popular Searches</p>
      <div class="flex flex-wrap gap-2">
        {[
          { label: '3-bedroom bungalow in Kiambu', href: '/counties/kiambu' },
          { label: 'Cement prices today', href: '/guides/cement-prices-in-kenya-today' },
          { label: 'Mabati prices 2026', href: '/guides/mabati-prices-in-kenya-2026-guide' },
          { label: '4-bedroom maisonette cost', href: '/guides/cost-to-build-a-maisonette-in-kenya' },
          { label: '2-bedroom house cost', href: '/guides/cost-of-building-a-2-bedroom-house-in-kenya' },
          { label: 'Build vs buy', href: '/guides/cost-to-build-vs-buy-a-house-in-kenya' },
          { label: 'Rental unit cost', href: '/guides/building-a-rental-unit-in-kenya-cost-guide' },
          { label: 'Solar backup power', href: '/guides/solar-backup-power-cost-guide-kenya' },
        ].map((item) => (
          <a
            href={item.href}
            class="rounded-full border border-ink-200 bg-white px-4 py-2 text-sm text-ink-600 transition-all hover:border-clay-400 hover:text-clay-700"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide py-16 md:py-20" id="calculator">
    <div class="mb-8 max-w-2xl">
      <p class="eyebrow">The Tool</p>
      <h2 class="mt-3 font-display text-display-md font-semibold text-ink-900">
        Build Cost Calculator
      </h2>
      <p class="mt-3 text-lg text-ink-600">
        Answer a few quick steps about your county, house, and plot — then get a personalized cost range for <em class="text-ink-900 not-italic">your</em> build, not a generic per-sqm guess.
      </p>
    </div>

    <CostCalculator client:idle />
  </section>

  {/* Price Snapshot */}
  <section class="border-y border-ink-200 bg-white py-16 md:py-20">
    <div class="container-wide">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Material Prices</p>
          <h2 class="mt-3 font-display text-display-md font-semibold text-ink-900">
            Today's Prices
          </h2>
        </div>
        <a href="/prices" class="link-underline text-sm font-medium text-clay-600">View all 30+ materials &rarr;</a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {popularMaterials.map((m) => (
          <div class="card flex items-center justify-between p-5">
            <div>
              <p class="text-sm font-medium text-ink-800">{m.materialName}</p>
              <p class="mt-0.5 text-xs text-ink-400">{m.unit} &middot; {m.category}</p>
            </div>
            <p class="font-mono text-lg font-semibold text-clay-600">
              {m.priceKes.toLocaleString('en-KE')}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Guides */}
  <section class="container-wide py-16 md:py-20">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Build Guides</p>
        <h2 class="mt-3 font-display text-display-md font-semibold text-ink-900">
          Learn Before You Build
        </h2>
      </div>
      <a href="/guides" class="link-underline text-sm font-medium text-clay-600">All guides &rarr;</a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featuredGuides.map((guide) => (
        <a href={`/guides/${guide.slug}`} class="card group flex flex-col p-6 transition-all hover:shadow-md">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-clay-50 px-2.5 py-0.5 text-xs font-medium text-clay-700">{guide.category}</span>
            <span class="text-xs text-ink-400">{guide.readTime}</span>
          </div>
          <h3 class="mt-4 font-display text-lg font-medium text-ink-900 group-hover:text-clay-700">
            {guide.title}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{guide.description}</p>
          <span class="mt-4 text-sm font-medium text-clay-600 group-hover:text-clay-700">Read guide &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  {/* Trust / How it works */}
  <section class="border-t border-ink-200 bg-ink-900 py-16 text-ink-100 md:py-20">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="eyebrow text-clay-300">Why JengaCalc</p>
        <h2 class="mt-3 font-display text-display-md font-semibold text-ink-50">
          The information gap is where the money is lost.
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-300">
          Most Kenyans lose 15–30% of their build budget to overcharging, material theft, and padded labor costs — because the fundi knows the prices and you don't. We close that gap.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div>
          <div class="font-display text-3xl font-semibold text-clay-300">01</div>
          <h3 class="mt-3 font-display text-lg text-ink-50">Real Prices</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">
            We track prices from hardware stores, supplier websites, and user submissions — updated monthly. No stale 2024 figures.
          </p>
        </div>
        <div>
          <div class="font-display text-3xl font-semibold text-clay-300">02</div>
          <h3 class="mt-3 font-display text-lg text-ink-50">Itemised BOQ</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">
            Every estimate breaks down foundation, walls, roofing, electrical, plumbing, finishes, and labor — so you know where every shilling goes.
          </p>
        </div>
        <div>
          <div class="font-display text-3xl font-semibold text-clay-300">03</div>
          <h3 class="mt-3 font-display text-lg text-ink-50">County-Level</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">
            Labor and transport costs vary by county. Nairobi is not Nakuru is not Mombasa. Our calculator adjusts for where you build.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="border-t border-ink-200 bg-ink-50 py-16 md:py-20">
    <div class="container-wide">
      <div class="mb-10 max-w-2xl">
        <p class="eyebrow">Real Answers</p>
        <h2 class="mt-3 font-display text-display-md font-semibold text-ink-900">
          What Kenyan Builders Actually Ask
        </h2>
        <p class="mt-3 text-lg text-ink-600">
          Field-level questions from construction forums and real projects �?" answered straight.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {[
          {
            q: 'How much does it cost to build a house per square metre in Kenya in 2026?',
            a: 'Roughly KES 35,000�?"45,000/m² for basic finishes, 50,000�?"65,000/m² for mid-range, and 70,000�?"95,000/m² for high-end, before land. Central Nairobi runs 25�?"30% above the national average. Use the calculator for a county-adjusted figure.',
          },
          {
            q: 'Why is my quoted cost so much higher than I budgeted?',
            a: 'Usually because of hidden items: material transport to site, county approvals, professional fees, black cotton soil foundation work, and a missing contingency. Budget 10�?"15% extra as contingency and itemise the BOQ to see the difference.',
          },
          {
            q: 'Is black cotton soil a problem for building in Kenya?',
            a: 'Yes, in areas like Kitengela, Syokimau, Athi River, Kamulu, and parts of Kajiado, Kiambu, Machakos, and the Rift Valley. It swells and shrinks with moisture, so a soil test and a raft foundation, soil replacement, or piles are essential. These can add 30�?"50% to foundation cost but prevent cracks later.',
          },
          {
            q: 'How long does it take to build a bungalow in Kenya?',
            a: 'Expect 6�?"12 months for a bungalow and longer for a maisonette, including the two rainy seasons (roughly March�?"May and October�?"December) which can pause concrete and foundation work.',
          },
          {
            q: 'How do I avoid being scammed when building remotely from abroad?',
            a: 'Never pay more than 10% mobilisation upfront, pay in stages with a 10% retention per stage, hold a final 10% until the 3�?"6 month defects period ends, appoint someone on the ground to inspect weekly, and get a written contract with a payment schedule and defects clause.',
          },
          {
            q: 'Why do material prices vary so much between counties?',
            a: 'Transport and supply chains. Nairobi has the cheapest delivered materials; rural and coastal counties pay a delivery premium. That is why we adjust every material and labor rate by county rather than giving one national figure.',
          },
        ].map((item) => (
          <details class="card p-5 group open:shadow-md">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink-900">
              {item.q}
              <span class="text-clay-600 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
