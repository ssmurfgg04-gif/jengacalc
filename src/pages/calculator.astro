---
import Base from '@/layouts/Base.astro';
import CostCalculator from '@/components/CostCalculator.tsx';
---

<Base
  title="Build Cost Calculator — Kenya | JengaCalc"
  description="Free interactive build cost calculator for Kenya. Get an itemised Bill of Quantities for your bungalow, maisonette, or rental unit in any county. Updated August 2026."
>
  <section slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How much does it cost to build a house in Kenya?",
          acceptedAnswer: { "@type": "Answer", text: "A 3-bedroom bungalow in Kenya costs KES 3.8M to 5.6M all-in as of 2026, depending on county and finish level. A 4-bedroom maisonette costs KES 5.5M to 7.5M. Use the JengaCalc calculator for a tailored estimate." }
        },
        {
          "@type": "Question",
          name: "How accurate is the JengaCalc build cost calculator?",
          acceptedAnswer: { "@type": "Answer", text: "Our calculator gives a cost range (not a fake precise number) based on real Kenyan construction rates, adjusted for county-level labor and transport costs. It is accurate enough for budgeting, but always confirm with a contractor before committing." }
        },
        {
          "@type": "Question",
          name: "What is the cost per square metre to build in Kenya?",
          acceptedAnswer: { "@type": "Answer", text: "In Kenya, construction costs range from KES 32,000/sqm for basic finishes to KES 62,000/sqm for high-end finishes as of 2026. Mid-range finishes cost around KES 42,000/sqm." }
        },
      ]
    })} />
  </section>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-20">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow text-clay-300">Calculator</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        Estimate your build cost in seconds
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        Choose your county, house type, and finish level. We'll give you a real cost range with a full breakdown — not a fake precise number.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <CostCalculator client:load />
  </section>

  <section class="container-prose py-12">
    <h2 class="font-display text-2xl font-medium text-ink-900">How this calculator works</h2>
    <div class="prose-kenya mt-4">
      <p>
        Our calculator uses a <strong>cost-per-square-metre</strong> model calibrated to Kenyan construction rates as of August 2026. The base rates are:
      </p>
      <ul>
        <li><strong>Basic (rental standard):</strong> KES 32,000/sqm — cement floors, basic fittings, standard mabati roof</li>
        <li><strong>Mid-range (owner-occupier):</strong> KES 42,000/sqm — tiled floors, painted interior, decent kitchen and bath</li>
        <li><strong>High-end (premium):</strong> KES 62,000/sqm — premium tiles or hardwood, fitted kitchen, quality sanitary ware</li>
      </ul>
      <p>
        These base rates are then adjusted for:
      </p>
      <ul>
        <li><strong>House type</strong> — maisonettes cost ~12% more per sqm due to the stronger foundation, first-floor slab, and staircase</li>
        <li><strong>County</strong> — labor rates and transport costs vary significantly across Kenya</li>
        <li><strong>A range, not a point estimate</strong> — we show a ±12% range because real builds vary. Ranges build more trust than false precision.</li>
      </ul>
      <p>
        The total is then broken down into 8 construction stages: foundation, walls, roofing, doors &amp; windows, electrical, plumbing, finishes, and labor. Each stage's share is based on typical Kenyan build cost distributions.
      </p>
      <p>
        <strong>Note:</strong> This estimate covers construction only. It excludes professional fees (architect, engineer, QS — typically 3–5% of construction cost), county approvals and NCA fees (KES 100,000–200,000), and a 10% contingency. Add these for your all-in budget.
      </p>
    </div>
  </section>
</Base>
