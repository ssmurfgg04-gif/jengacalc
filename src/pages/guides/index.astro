---
import Base from '@/layouts/Base.astro';
import { GUIDES } from '@/data/kenya';

const categories = ['All', ...new Set(GUIDES.map((g) => g.category))];
---

<Base
  title="Build Guides — Kenya Construction Advice | JengaCalc"
  description="In-depth guides on building costs, materials, design choices, and construction process in Kenya. Written for Kenyan builders, by people who know the market."
>
  <section class="border-b border-ink-200 bg-ink-900 py-16 text-ink-50 md:py-20">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow text-clay-300">Guides</p>
      <h1 class="mt-3 font-display text-display-lg font-semibold leading-tight text-ink-50 text-balance">
        Build guides for Kenyan builders
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-300 text-pretty">
        Real, field-tested advice on budgeting, materials, design, and process — written for the Kenyan market. No fluff, no generic AI paragraphs. Just what you need to know.
      </p>
    </div>
  </section>

  <section class="container-wide py-12 md:py-16">
    <div id="guide-list" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {GUIDES.map((guide) => (
        <a href={`/guides/${guide.slug}`} class="card group flex flex-col p-6 transition-all hover:shadow-md">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-clay-50 px-2.5 py-0.5 text-xs font-medium text-clay-700">{guide.category}</span>
            <span class="text-xs text-ink-400">{guide.readTime}</span>
          </div>
          <h2 class="mt-4 font-display text-lg font-medium text-ink-900 group-hover:text-clay-700">
            {guide.title}
          </h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{guide.description}</p>
          <span class="mt-4 text-sm font-medium text-clay-600 group-hover:text-clay-700">Read guide &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</Base>
