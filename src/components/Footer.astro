---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-200 bg-ink-900 text-ink-200">
  <div class="container-wide grid gap-10 py-16 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2.5">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" class="text-clay-300">
          <rect x="3" y="14" width="22" height="11" rx="1" stroke="currentColor" stroke-width="2" fill="none" />
          <path d="M14 3L25 14H3L14 3Z" stroke="currentColor" stroke-width="2" fill="none" stroke-linejoin="round" />
          <rect x="10" y="18" width="3" height="3" fill="currentColor" />
          <rect x="15" y="18" width="3" height="3" fill="currentColor" />
        </svg>
        <span class="font-display text-xl font-semibold text-ink-50">JengaCalc</span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-300">
        Kenya's most accurate build cost calculator and material price tracker.
        Get a real Bill of Quantities for your project in seconds — updated monthly
        with real prices from across the country.
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-clay-300">Tools</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/calculator" class="text-ink-300 hover:text-ink-50">Cost Calculator</a></li>
        <li><a href="/prices" class="text-ink-300 hover:text-ink-50">Material Prices</a></li>
        <li><a href="/counties" class="text-ink-300 hover:text-ink-50">County Guides</a></li>
        <li><a href="/guides" class="text-ink-300 hover:text-ink-50">Build Guides</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-clay-300">Popular Guides</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/guides/cost-to-build-a-3-bedroom-bungalow-in-kenya" class="text-ink-300 hover:text-ink-50">3-Bedroom Bungalow Cost</a></li>
        <li><a href="/guides/mabati-prices-in-kenya-2026-guide" class="text-ink-300 hover:text-ink-50">Mabati Prices 2026</a></li>
        <li><a href="/guides/cement-prices-in-kenya-today" class="text-ink-300 hover:text-ink-50">Cement Prices Today</a></li>
        <li><a href="/guides/how-to-budget-for-a-4-bedroom-house-in-kenya" class="text-ink-300 hover:text-ink-50">4-Bedroom Budget Guide</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <div class="container-wide flex flex-col items-center justify-between gap-3 py-6 text-xs text-ink-400 sm:flex-row">
      <p>&copy; {year} JengaCalc. Built for Kenyan builders.</p>
      <p>Prices are indicative. Always confirm with your supplier before buying.</p>
    </div>
  </div>
</footer>
