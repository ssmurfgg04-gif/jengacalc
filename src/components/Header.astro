---
const nav = [
  { href: '/calculator', label: 'Calculator' },
  { href: '/prices', label: 'Material Prices' },
  { href: '/guides', label: 'Guides' },
  { href: '/counties', label: 'Counties' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-ink-50/85 backdrop-blur-md">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="JengaCalc home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" class="text-clay-600">
        <rect x="3" y="14" width="22" height="11" rx="1" stroke="currentColor" stroke-width="2" fill="none" />
        <path d="M14 3L25 14H3L14 3Z" stroke="currentColor" stroke-width="2" fill="none" stroke-linejoin="round" />
        <rect x="10" y="18" width="3" height="3" fill="currentColor" />
        <rect x="15" y="18" width="3" height="3" fill="currentColor" />
      </svg>
      <span class="font-display text-xl font-semibold tracking-tight text-ink-900">JengaCalc</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`text-sm font-medium transition-colors ${
            path.startsWith(item.href)
              ? 'text-clay-600'
              : 'text-ink-600 hover:text-ink-900'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/calculator" class="btn-primary hidden sm:inline-flex">
      Estimate My Build
    </a>

    <button
      id="mobile-menu-toggle"
      class="md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-ink-700">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink-200 bg-ink-50 md:hidden">
    <nav class="container-wide flex flex-col gap-1 py-4" aria-label="Mobile navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class={`rounded-md px-3 py-2 text-sm font-medium ${
            path.startsWith(item.href)
              ? 'bg-clay-100 text-clay-700'
              : 'text-ink-600 hover:bg-ink-100'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a href="/calculator" class="btn-primary mt-2">Estimate My Build</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
  });
</script>
