---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const {
  title = 'JengaCalc — Kenya Build Cost Calculator & BOQ Estimator',
  description = 'Free Kenya construction cost calculator. Get an itemised Bill of Quantities for your house in seconds. Updated material prices for cement, steel, mabati, and more across all 47 counties.',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${canonicalURL.split('/').slice(0, 3).join('/')}/#organization`,
          name: 'JengaCalc',
          url: new URL('/', Astro.site).toString(),
          description: 'Kenya build-cost calculator and construction price tracker.',
          areaServed: 'Kenya',
          knowsAbout: ['Construction cost estimation', 'Building materials prices in Kenya', 'Bill of Quantities'],
        },
        {
          '@type': 'WebSite',
          '@id': `${canonicalURL.split('/').slice(0, 3).join('/')}/#website`,
          url: new URL('/', Astro.site).toString(),
          name: 'JengaCalc',
          publisher: { '@id': `${canonicalURL.split('/').slice(0, 3).join('/')}/#organization` },
        },
      ],
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', '{import.meta.env.PUBLIC_GA_ID}');
        </script>
      </>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
